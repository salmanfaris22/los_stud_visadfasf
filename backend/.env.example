# ── Backend (copy to .env) ─────────────────────────────────────────────
APP_ENV=development                # production enables strict checks + JSON logs
HTTP_ADDR=:8080
DATABASE_URL=postgres://lms:lms@localhost:5432/lms?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=                    # base64 of 32 random bytes:  openssl rand -base64 32
ADMIN_APP_URL=http://localhost:3001
STUDENT_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
COOKIE_DOMAIN=                     # e.g. .yoursite.com when apps use subdomains
COOKIE_SECURE=false                # true behind HTTPS
TRUST_PROXY=false                  # true behind Nginx/Caddy (reads X-Forwarded-For)
AUTO_MIGRATE=true
RUN_JOBS=true                      # live reminders + cleanup scheduler

# Object storage (Cloudflare R2 in production, MinIO locally)
S3_ENDPOINT=localhost:9000         # R2: <account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=lms
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false                   # true for R2
S3_CREATE_BUCKET=true              # false for R2 (create the bucket in the dashboard)
S3_PUBLIC_URL=                     # optional public bucket / CDN for thumbnails

# Email (Mailpit locally: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LMS <no-reply@lms.local>

# Google sign-in + Calendar/Meet/Drive sync (Google Cloud console → OAuth client)
# Redirect URIs: {API_PUBLIC_URL}/api/v1/auth/google/callback and {API_PUBLIC_URL}/api/v1/settings/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SEED_ADMIN_EMAIL=admin@lms.local
SEED_ADMIN_PASSWORD=Admin@12345

# ── Frontends ───────────────────────────────────────────────────────────
API_URL=http://localhost:8080      # where Next.js forwards /api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STUDENT_URL=http://localhost:3000
